generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String      @id @default(uuid())
  displayName        String
  phoneNumberId      String      @unique
  displayPhoneNumber String?
  accessToken        String
  businessLabel      String?
  wabaId             String?
  qualityRating      String?
  isActive           Boolean     @default(false)
  isArchived         Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  accountMode        String?     @default("SANDBOX")
  healthScore        Int?        @default(100)
  messagingLimit     Int?        @default(1000)
  broadcasts         Broadcast[]
}

model Contact {
  id              String        @id @default(uuid())
  name            String
  phone           String        @unique
  tags            Json?
  notes           String?
  brokerageNotes  String?
  leadStage       String        @default("NEW")
  status          String        @default("active")
  lastBroadcastAt DateTime?
  lastReplyAt     DateTime?
  unreadCount     Int           @default(0)
  lastMessageAt   DateTime?
  optInStatus     String        @default("unknown")
  optInMethod     String?
  optInTimestamp  DateTime?
  optOutTimestamp DateTime?
  optOutReason    String?
  isBlocklisted   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastAccountId   String?
  chatMessages    ChatMessage[]
  messages        MessageLog[]
}

model ChatMessage {
  id            String   @id @default(uuid())
  contactId     String
  fromMe        Boolean
  type          String   @default("text")
  body          String?
  mediaUrl      String?
  metaMessageId String?  @unique
  timestamp     DateTime @default(now())
  accountId     String?
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Segment {
  id          String   @id @default(uuid())
  name        String
  description String?
  filters     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Template {
  id              String      @id @default(uuid())
  metaTemplateId  String?     @unique
  wabaId          String?
  name            String
  category        String      @default("MARKETING")
  language        String      @default("en_US")
  useCaseLabel    String?
  headerType      String      @default("TEXT")
  header          String?
  mediaUrl        String?
  body            String
  footer          String?
  buttons         Json?
  variables       Json?
  status          String      @default("draft")
  rejectionReason String?
  isArchived      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  broadcasts      Broadcast[]
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  parent    Folder?  @relation("SubFolders", fields: [parentId], references: [id])
  children  Folder[] @relation("SubFolders")
  media     Media[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id         String   @id @default(uuid())
  url        String
  filename   String
  type       String   // IMAGE, VIDEO, AUDIO, DOCUMENT
  size       Int
  tags       Json?    // Array of strings
  campaign   String?
  language   String?
  purpose    String?
  status     String   @default("active")
  isArchived Boolean  @default(false)
  usageCount Int      @default(0)
  folderId   String?
  folder     Folder?  @relation(fields: [folderId], references: [id])
  metadata   Json?    // Technical specs (hash, width, height, duration, etc.)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Broadcast {
  id            String       @id @default(uuid())
  accountId     String
  templateId    String
  contactIds    Json
  status        String       @default("pending")
  results       Json?
  sentAt        DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  correlationId String?
  isPaused      Boolean      @default(false)
  stopReason    String?
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template      Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  messages      MessageLog[]
}

model MessageLog {
  id             String    @id @default(uuid())
  broadcastId    String
  contactId      String
  status         String    @default("queued")
  metaMessageId  String?   @unique
  error          String?
  sentAt         DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  idempotencyKey String?   @unique
  correlationId  String?
  broadcast      Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id          String   @id @default("global")
  isPaused    Boolean  @default(false)
  pauseReason String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model WebhookSetting {
  id            String    @id @default(uuid())
  url           String
  verifyToken   String
  isActive      Boolean   @default(true)
  subscriptions String    @default("messages,statuses")
  lastSyncAt    DateTime?
  metaStatus    String    @default("unknown")
  metaError     String?
  healthStatus  String    @default("unknown")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
